{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ugarit/ugarit",
    "type": "project",
    "description": "The skeleton application for the Ugarit framework.",
    "keywords": [
        "ugarit",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ugarit/framework": "^1.00.00",
        "ugarit/tinker": "^1.00.00"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "ugarit/boost": "^1.00.00",
        "ugarit/pail": "^1.00.00",
        "ugarit/pint": "^1.00.00",
        "ugarit/sail": "^1.00.00",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php scribe config:clear",
            "@php scribe clear-compiled",
            "@php scribe package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php scribe vendor:publish --tag=ugarit-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php scribe key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php scribe migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php scribe serve\" \"php scribe queue:listen --tries=1\" \"php scribe pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php scribe config:clear --ansi",
            "@php scribe test"
        ]
    },
    "extra": {
        "ugarit": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "version": "1.00.00"
}
